<?xml version="1.0" encoding="utf-8"?><!--
  ~ Copied from open-rmbt-android (layout-land/activity_measurement.xml): the curve on the left, the
  ~ network and the bottom panel on the right. Signal, frequency, server, GPS speed, expert and loop views
  ~ are removed; the values are set from code (view binding).
  -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/measurementRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rmbt_measurement_dark_gray">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/verticalHalf"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.80" />

    <tj.zehn.rmbt.ui.view.curve.MeasurementCurveLayout
        android:id="@+id/curve_layout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/measurementBottomView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/network_name_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rmbt_padding_medium"
        android:text="@string/rmbt_network_label"
        android:textColor="@color/rmbt_text_white_transparency_40"
        android:textSize="@dimen/rmbt_network_label_size"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/measurementBottomView"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/network_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/rmbt_padding_medium"
        android:accessibilityTraversalAfter="@id/network_name_label"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@android:color/background_light"
        android:textSize="@dimen/rmbt_network_name_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/verticalHalf"
        app:layout_constraintStart_toStartOf="@id/measurementBottomView"
        app:layout_constraintTop_toBottomOf="@id/network_name_label" />

    <TextView
        android:id="@+id/network_tech_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rmbt_padding_medium"
        android:layout_marginEnd="@dimen/rmbt_padding_large"
        android:text="@string/rmbt_technology_label"
        android:textColor="@color/rmbt_text_white_transparency_40"
        android:textSize="@dimen/rmbt_network_label_size"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/verticalHalf"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/technology_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/rmbt_padding_large"
        android:accessibilityTraversalAfter="@id/network_tech_label"
        android:textColor="@android:color/background_light"
        android:textSize="@dimen/rmbt_network_name_size"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/network_tech_label"
        app:layout_constraintTop_toBottomOf="@id/network_tech_label" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/header_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="network_name,technology_name" />

    <ImageView
        android:id="@+id/buttonCancel"
        android:layout_width="@dimen/rmbt_toolbar_button_size"
        android:layout_height="@dimen/rmbt_toolbar_button_size"
        android:layout_marginTop="@dimen/rmbt_margin_small"
        android:layout_marginEnd="@dimen/rmbt_margin_small"
        android:accessibilityTraversalAfter="@id/technology_name"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/rmbt_measurement_cancel"
        android:scaleType="center"
        android:src="@drawable/rmbt_ic_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/measurementBottomView"
        layout="@layout/rmbt_measurement_bottom_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/rmbt_margin_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_barrier"
        app:layout_constraintWidth_percent="0.45" />

</androidx.constraintlayout.widget.ConstraintLayout>
