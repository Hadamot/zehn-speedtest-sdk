<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <tj.zehn.rmbt.ui.view.curve.MeasurementCurveView
            android:id="@+id/curveView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/rmbt_margin_medium"
            android:layout_marginEnd="@dimen/rmbt_margin_medium" />
        <include
            android:id="@+id/layout_strength"
            layout="@layout/rmbt_view_strength_signal_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/rmbt_signal_bar_start_margin"
            android:layout_marginTop="@dimen/rmbt_signal_bar_top_margin" />
    </FrameLayout>
